# ===========================================
# FitView AI — Backend Environment Variables
# Copy this file to .env and fill in real values
# ===========================================

# Data storage (JSON files for dev, MongoDB for prod)
DATA_DIR=data

# JWT — MUST change for production!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=FitView AI
DEBUG=false
API_V1_PREFIX=/api/v1
BASE_URL=http://localhost:8000

# File uploads
UPLOAD_DIR=uploads

# Google Gemini — virtual try-on & style variations
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Vertex AI (optional — set USE_VERTEX_AI=true to use service account instead of API key)
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_SERVICE_ACCOUNT_JSON=
USE_VERTEX_AI=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fitview_prod

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 / CloudFront
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Security — update for production domain
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Login with Amazon (OAuth)
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# AWS Bedrock (chatbot)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_CHAT_MODEL_ID=qwen.qwen3-32b-v1:0
USE_BEDROCK=true
