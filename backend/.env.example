# ===========================================
# FitView AI — Backend Production .env
# Domain: fitviewai.store
# ===========================================

# Data storage
DATA_DIR=data

# JWT — CHANGE THIS to a real secret!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=FitView AI
DEBUG=false
API_V1_PREFIX=/api/v1
BASE_URL=https://fitviewai.store

# File uploads
UPLOAD_DIR=uploads

# AI APIs
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fitview_prod

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 / CloudFront
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=aws-hackathon-fitview
CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Security — production domain
ALLOWED_ORIGINS=https://fitviewai.store,https://www.fitviewai.store
ALLOWED_HOSTS=fitviewai.store,www.fitviewai.store

# AWS Bedrock (Qwen3 chatbot)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_CHAT_MODEL_ID=qwen.qwen3-32b-v1:0
USE_BEDROCK=true
